# ── Imágenes como binario (sin diff, sin conversión de línea) ──
*.png binary linguist-generated=false
*.jpeg binary linguist-generated=false
*.jpg binary linguist-generated=false
*.webp binary linguist-generated=false

# ── Texto con terminación LF (consistente en Windows/Linux) ──
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.md text eol=lf
*.json text eol=lf

